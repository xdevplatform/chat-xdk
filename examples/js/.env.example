# Copy to .env and fill in. Never commit your real .env.

# OAuth2 user access token with the dm.read + dm.write scopes.
# Used by the dev server (server.mjs) and the headless bot (src/bot.mjs).
X_ACCESS_TOKEN=

# The conversation the headless bot watches (other user's ID, or "g..." group).
CHAT_CONVERSATION_ID=

# The bot's private key blob (base64), as printed on first run of `npm run bot`.
# Leave blank to generate + register a new identity.
CHAT_PRIVATE_KEYS_B64=

# The version the X API reports for the bot's registered public key.
CHAT_SIGNING_KEY_VERSION=1

# Optional: the bot's own user ID. If blank it is fetched via /2/users/me.
CHAT_BOT_USER_ID=

# Optional: dev server port (browser app).
PORT=8787
